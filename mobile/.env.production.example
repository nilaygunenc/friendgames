# ─────────────────────────────────────────────────────────────────
# FriendGames Mobile - PRODUCTION Environment Variables
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# API Configuration (ZORUNLU)
# ─────────────────────────────────────────────────────────────────
# Backend API URL (Render.com, Railway, vb.)
EXPO_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# ─────────────────────────────────────────────────────────────────
# RevenueCat Configuration (VIP için gerekli)
# ─────────────────────────────────────────────────────────────────
# RevenueCat Dashboard → Apps → [Your App] → API Keys
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_xxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────
# Build Öncesi Kontrol
# ─────────────────────────────────────────────────────────────────
# [ ] EXPO_PUBLIC_API_URL production backend'e işaret ediyor
# [ ] Backend çalışıyor ve health check OK
# [ ] RevenueCat API key doğru
# [ ] app.json güncellendi (version, bundle id)
# [ ] eas.json güncellendi
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# Build Komutları
# ─────────────────────────────────────────────────────────────────
# Preview build (internal testing):
# eas build --platform android --profile preview

# Production build (Play Store):
# eas build --platform android --profile production

# iOS build:
# eas build --platform ios --profile production
# ─────────────────────────────────────────────────────────────────
