					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="tr" dir="ltr" data-mw-parsoid-version="0.25.0.0-alpha1" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt1" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Televizyon sezonu bilgi kutusu\n","href":"./Şablon:Televizyon_sezonu_bilgi_kutusu"},"params":{"arkaplan":{"wt":"#D09916"},"yazı_rengi":{"wt":"#fff"},"program_adı":{"wt":"Muhteşem Yüzyıl"},"sezon_no":{"wt":"1"},"resim":{"wt":"Muhteşem Yüzyıl 1 Sezon.jpg"},"altyazı":{"wt":"Sezonun afişi"},"dvd_yayın_tarihi":{"wt":""},"dvd_formatı":{"wt":""},"ülke":{"wt":"{{TUR}}"},"kanal":{"wt":"[[Show TV]]"},"ilk_gösterim":{"wt":"{{Başlangıç tarihi|2011|1|5|df=y}}"},"son_gösterim":{"wt":"{{Bitiş tarihi|2011|6|22|df=y}}"},"bölüm_sayısı":{"wt":"24"},"ana_kadro":{"wt":"[[Halit Ergenç]]&lt;br>[[Nebahat Çehre]]&lt;br>[[Meryem Uzerli]]&lt;br>[[Okan Yalabık]]&lt;br>[[Selma Ergeç]]&lt;br>[[Nur Fettahoğlu]]&lt;br>[[Selen Öztürk]]"}},"i":0}}]}'></span><style data-mw-deduplicate="TemplateStyles:r36982844" typeof="mw:Extension/templatestyles" about="#mwt1" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent}.mw-parser-output .infobox-3cols-child{margin:auto}.mw-parser-output .infobox .navbar{font-size:100%}body.skin-minerva .mw-parser-output .infobox-header,body.skin-minerva .mw-parser-output .infobox-subheader,body.skin-minerva .mw-parser-output .infobox-above,body.skin-minerva .mw-parser-output .infobox-title,body.skin-minerva .mw-parser-output .infobox-image,body.skin-minerva .mw-parser-output .infobox-full-data,body.skin-minerva .mw-parser-output .infobox-below{text-align:center}</style><table class="infobox" about="#mwt1" id="mwAw"><tbody><tr><th colspan="2" class="infobox-above" style="padding-top: 5px; padding-bottom: 5px; background: #D09916; color: black;"><i>Muhteşem Yüzyıl</i></th></tr><tr><td colspan="2" class="infobox-subheader padding-top: 2px; padding-bottom: 2px; background: #D09916; color: black; text-align: center; line-height: 1.5em; font-weight: bold; font-size: 120%;" style="padding-top: 2px; padding-bottom: 2px; background: #D09916; color: black; text-align: center; line-height: 1.5em; font-weight: bold; font-size: 120%;">1. sezon</td></tr><tr><td colspan="2" class="infobox-image"><span class="mw-default-size" typeof="mw:File/Frameless"><a href="https://tr.wikipedia.org/wiki/Dosya:Muhteşem_Yüzyıl_1_Sezon.jpg" class="mw-file-description"><img resource="https://tr.wikipedia.org/wiki/Dosya:Muhteşem_Yüzyıl_1_Sezon.jpg" src="//thumb.wikimedia.org/wikipedia/tr/thumb/3/31/Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_1_Sezon.jpg/250px-Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_1_Sezon.jpg?utm_source=tr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/tr/thumb/3/31/Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_1_Sezon.jpg/500px-Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_1_Sezon.jpg?utm_source=tr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="600" data-file-height="898" data-file-type="bitmap" height="374" width="250" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1"/></a></span><div class="infobox-caption">Sezonun afişi</div></td></tr><tr><th scope="row" class="infobox-label">Başrol</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Halit_Ergenç" title="Halit Ergenç">Halit Ergenç</a><br/><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Nebahat_Çehre" title="Nebahat Çehre">Nebahat Çehre</a><br/><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Meryem_Uzerli" title="Meryem Uzerli">Meryem Uzerli</a><br/><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Okan_Yalabık" title="Okan Yalabık">Okan Yalabık</a><br/><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Selma_Ergeç" title="Selma Ergeç">Selma Ergeç</a><br/><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Nur_Fettahoğlu" title="Nur Fettahoğlu">Nur Fettahoğlu</a><br/><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Selen_Öztürk" title="Selen Öztürk">Selen Öztürk</a></td></tr><tr><th scope="row" class="infobox-label">Ülke</th><td class="infobox-data description"><span class="datasortkey" data-sort-value="Türkiye"><span class="flagicon"><span class="mw-image-border" typeof="mw:File"><span><img resource="https://tr.wikipedia.org/wiki/Dosya:Flag_of_Turkey.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b4/Flag_of_Turkey.svg/40px-Flag_of_Turkey.svg.png?utm_source=tr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b4/Flag_of_Turkey.svg/60px-Flag_of_Turkey.svg.png?utm_source=tr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="" data-file-width="1200" data-file-height="800" data-file-type="drawing" height="15" width="23" class="mw-file-element"/></span></span><span typeof="mw:Entity"> </span></span><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Türkiye" title="Türkiye">Türkiye</a></span></td></tr><tr><th scope="row" class="infobox-label">Bölüm sayısı</th><td class="infobox-data">24</td></tr><tr><th colspan="2" class="infobox-header" style="background: #D09916; color: black;">Yayın</th></tr><tr><th scope="row" class="infobox-label">Kanal</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Show_TV" title="Show TV">Show TV</a></td></tr><tr><th scope="row" class="infobox-label">Orijinal yayın tarihi</th><td class="infobox-data"><span data-sort-value="20110105 !">5 Ocak 2011</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">2011-01-05</span>)</span><link rel="mw:PageProp/Category" href="./Kategori:2011_televizyon_sezonları"/>-<span data-sort-value="20110622 !">22 Haziran 2011</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">2011-06-22</span>)</span><link rel="mw:PageProp/Category" href="./Kategori:2011_televizyon_sezonları"/></td></tr><tr><th colspan="2" class="infobox-header" style="background: #D09916; color: black;">Sezon kronolojisi</th></tr><tr><td colspan="2" class="infobox-full-data"><div style="float: left; "></div>
<div style="float: right; "><b>Sonraki</b><span typeof="mw:Entity"> </span>→<br/><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Muhteşem_Yüzyıl_(2._sezon)" title="Muhteşem Yüzyıl (2. sezon)">2. sezon</a></div></td></tr><tr><td colspan="2" class="infobox-below"><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Muhteşem_Yüzyıl_bölümleri_listesi" title="Muhteşem Yüzyıl bölümleri listesi"><i>Muhteşem Yüzyıl </i> bölümleri</a></td></tr></tbody></table>

<p id="mwBA"><i id="mwBQ"><b id="mwBg"><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Muhteşem_Yüzyıl" title="Muhteşem Yüzyıl" id="mwBw">Muhteşem Yüzyıl</a></b></i> dizisinin ilk sezonu 5 Ocak 2011 tarihinde <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Türkiye" title="Türkiye" id="mwCA">Türkiye</a>'de yayımlanmaya başladı ve 22 Haziran 2011 tarihinde sona erdi. İlk sezonda; henüz şehzade olan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/I._Süleyman" title="I. Süleyman" id="mwCQ">Süleyman</a>'ın, babası <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/I._Selim" title="I. Selim" id="mwCg">I. Selim</a>'in ölümü üzerine Osmanlı tahtına geçmesi ve bu zamanlarda saray haremine cariye olarak getirilen <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Hürrem_Sultan" title="Hürrem Sultan" id="mwCw">Hürrem Sultan</a> ile birbirlerine âşık olmaları, ardından Süleyman'ın saltanatının ilk yılları ve Hürrem Sultan'ın intikam için başlattığı iktidar oyunu konu alınmaktadır. İlk sezon toplam 24 bölümden oluştu ve Türkiye'de çarşamba akşamları gösterildi.</p>

<meta property="mw:PageProp/toc" id="mwDA" data-mw='{"autoGenerated":true}'/></section><section data-mw-section-id="1" id="mwDQ" aria-labelledby="Sezon_özeti"><div class="mw-heading mw-heading2"><h2 id="Sezon_özeti"><span id="Sezon_.C3.B6zeti" typeof="mw:FallbackId"></span>Sezon özeti</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;veaction=edit&amp;section=1" title="Değiştirilen bölüm: Sezon özeti" class="mw-editsection-visualeditor"><span>değiştir</span></a><span class="mw-editsection-divider"> | </span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;action=edit&amp;section=1" title="Bölümün kaynak kodunu değiştir: Sezon özeti"><span>kaynağı değiştir</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwDg"><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/I._Süleyman" title="I. Süleyman" id="mwDw">Süleyman</a>, en yakın arkadaşı <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Pargalı_İbrahim_Paşa" title="Pargalı İbrahim Paşa" id="mwEA">Pargalı İbrahim</a> ile Manisa'da av gezisindeyken babası <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/I._Selim" title="I. Selim" id="mwEQ">I. Selim</a>'in öldüğü haberini alır ve tahtına geçmek üzere <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Topkapı_Sarayı" title="Topkapı Sarayı" id="mwEg">Topkapı Sarayı</a>'na gelir. Bu sıralarda Rutenyalı bir köle olarak deniz yoluyla <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Kırım" title="Kırım" id="mwEw">Kırım</a>'dan saraya getirilen Alexandra Lisowska, padişahtan bir erkek çocuk sahibi olduğu takdirde sarayda yükselebileceğini ve dünyaya hükmedebileceğini öğrenir. Bunun üzerine Süleyman'ın dikkatini çekmek için onun önünde bayılır ve daha sonra Süleyman tarafından halvete çağrılır. Süleyman, Alexandra'ya âşık olur ve onu Müslüman yapar; sonrasında ise ona "güler yüzlü" anlamına gelen <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Hürrem_Sultan" title="Hürrem Sultan" id="mwFA">Hürrem</a> adını verir. Hürrem, ilk oğlu <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Şehzade_Mehmed_(I._Süleyman'ın_oğlu)" title="Şehzade Mehmed (I. Süleyman'ın oğlu)" id="mwFQ">Şehzade Mehmed</a>'i dünyaya getirince sarayda yükselmeye başlar. Bu durum, padişahın hasekisi ve büyük oğlu <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Şehzade_Mustafa" title="Şehzade Mustafa" id="mwFg">Şehzade Mustafa</a>'nın annesi <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Mahidevran_Sultan" title="Mahidevran Sultan" id="mwFw">Mahidevran Sultan</a> tarafından hoş karşılanmaz. Ertesi yıl Hürrem Sultan, ilk ve tek kızı olan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Mihrimah_Sultan_(I._Süleyman'ın_kızı)" title="Mihrimah Sultan (I. Süleyman'ın kızı)" id="mwGA">Mihrimah Sultan</a>'ı dünyaya getirir.</p>

<p id="mwGQ">Süleyman, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Belgrad'ın_Fethi" title="Belgrad'ın Fethi" id="mwGg">Belgrad Seferi</a> (1521) sırasında Victoria adında birinin kocasını öldürür. Victoria ise intikam almak üzere İstanbul'a gelir ve <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Matrakçı_Nasuh" title="Matrakçı Nasuh" id="mwGw">Matrakçı Nasuh</a> tarafından Pargalı İbrahim'e götürülür. Daha sonra Topkapı Sarayı'na getirilen Victoria, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Harem_(Osmanlı_İmparatorluğu)" title="Harem (Osmanlı İmparatorluğu)" id="mwHA">hareme</a> girer ve adını Sadıka olarak değiştirip Süleyman'ın ve validesinin hizmetinde çalışmaya başlar. Haremde çıkan bir yangında şehzadeleri kurtarınca sarayda kendisine duyulan güven artar.</p>

<p id="mwHQ">Süleyman, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Rodos_Kuşatması_(1522)" title="Rodos Kuşatması (1522)" id="mwHg">Rodos Seferi</a> (1522) dönüşünde <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Pîrî_Mehmed_Paşa" title="Pîrî Mehmed Paşa" id="mwHw">Pîrî Mehmed Paşa</a>'yı sadrazamlıktan azleder ve yerine has odabaşısı Pargalı İbrahim'i getirir. Bu durum devlet yöneticileri tarafından şaşkınlıkla karşılanır. İbrahim, Süleyman'a kardeşi <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Hatice_Sultan_(I._Selim'in_kızı)" title="Hatice Sultan (I. Selim'in kızı)" id="mwIA">Hatice Sultan</a>'a âşık olduğunu itiraf eder ve ikili kısa bir süre sonra görkemli bir düğünle evlenir. Düğün sırasında Hürrem, ikinci şehzadesi <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/II._Selim" title="II. Selim" id="mwIQ">Selim</a>'i doğurur. İbrahim Paşa'nın sadrazam olmasından ötürü büyük bir öfkeye kapılan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Hain_Ahmed_Paşa" title="Hain Ahmed Paşa" id="mwIg">Ahmed Paşa</a>, devlet tarafından zorla görevlendirildiği Mısır'da isyana kalkışır ve akabinde öldürülür. İbrahim Paşa, Mısır'a düzeni sağlaması için gönderilir. Bu sırada başkentte çıkan bir <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Yeniçeri_İsyanı_(1525)" title="Yeniçeri İsyanı (1525)" id="mwIw">yeniçeri isyanı</a> kısa sürede bastırılır. Hatice Sultan, isyan sırasında çıkan kargaşada karnındaki çocuğunu düşürür.</p>

<p id="mwJA">Daha sonra Hürrem Sultan'ın <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Rutenya" title="Rutenya" id="mwJQ">Rutenya</a>'daki sevgilisi Leo ortaya çıkar. Leo, Sultan Süleyman tarafından kendisiyle Hürrem Sultan'ın resmini yapması için sarayda görevlendirilir. Leo ile Hürrem, aralarındaki ilişkiyi herkesten gizlerler. Durumu öğrenen Pargalı İbrahim, bunu Hürrem Sultan'a karşı bir koz olarak kullanır. Tam da bu sırada Victoria, Süleyman'ı öldürmek üzere boğazına hançer dayar. İbrahim, Hürrem Sultan'dan kurtulmak için Leo ile Hürrem'i bir araya getirir ve ellerine bir kase zehirli lokum verir. Süleyman'ın durumu öğrenmemesi için ikisinden birinin zehirli lokumlardan yemesi gerekir.</p>

</section><section data-mw-section-id="2" id="mwJg" aria-labelledby="Teknik_ekip"><div class="mw-heading mw-heading2"><h2 id="Teknik_ekip">Teknik ekip</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;veaction=edit&amp;section=2" title="Değiştirilen bölüm: Teknik ekip" class="mw-editsection-visualeditor"><span>değiştir</span></a><span class="mw-editsection-divider"> | </span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;action=edit&amp;section=2" title="Bölümün kaynak kodunu değiştir: Teknik ekip"><span>kaynağı değiştir</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwJw">Sezonun prodüksiyonu, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Timur_Savcı" title="Timur Savcı" id="mwKA">Timur Savcı</a>'nın başında olduğu <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/TİMSBİ_Productions" title="TİMSBİ Productions" id="mwKQ">Tims&amp;B Productions</a> şirketi tarafından gerçekleştirildi. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Meral_Okay" title="Meral Okay" id="mwKg">Meral Okay</a> hikâyeyi ve senaryoyu, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Yılmaz_Şahin" title="Yılmaz Şahin" id="mwKw">Yılmaz Şahin</a> ise <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Tretman" title="Tretman" id="mwLA">tretmanı</a> kaleme aldı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Taylan_Biraderler" title="Taylan Biraderler" id="mwLQ">Taylan Biraderler</a> olarak bilinen Yağmur Taylan ve Durul Taylan, ilk sezondaki tüm bölümlerin yönetmenliğini üstlendiler. Dizinin müzikleri <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Fahir_Atakoğlu" title="Fahir Atakoğlu" id="mwLg">Fahir Atakoğlu</a>, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Aytekin_Ataş" title="Aytekin Ataş" id="mwLw">Aytekin Ataş</a> ve Soner Akalın tarafından bestelendi. Genel koordinatörlüğü Nermin Eroğlu üstlendi. Aydın Sarıoğlu ve <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Ercan_Özkan" title="Ercan Özkan" id="mwMA">Ercan Özkan</a> dizinin görüntü yönetmenliğini, Nilüfer Giritlioğlu ise sanat yönetmenliğini yaptı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Kurgu_(sinema)" title="Kurgu (sinema)" id="mwMQ">Kurguyu</a> ise Emrullah Hekim ve Aykut Yıldırım yaptı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Kostüm_tasarımcısı" title="Kostüm tasarımcısı" id="mwMg">Kostüm tasarımından</a> Serdar Başbuğ sorumlu oldu. Dr. Deniz Esemenli ve Doç. Dr. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Erhan_Afyoncu" title="Erhan Afyoncu" id="mwMw">Erhan Afyoncu</a>, ilk sezonun tarih danışmanları olarak görev yaptılar.</p>

</section><section data-mw-section-id="3" id="mwNA" aria-labelledby="Oyuncu_kadrosu"><div class="mw-heading mw-heading2"><h2 id="Oyuncu_kadrosu">Oyuncu kadrosu</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;veaction=edit&amp;section=3" title="Değiştirilen bölüm: Oyuncu kadrosu" class="mw-editsection-visualeditor"><span>değiştir</span></a><span class="mw-editsection-divider"> | </span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;action=edit&amp;section=3" title="Bölümün kaynak kodunu değiştir: Oyuncu kadrosu"><span>kaynağı değiştir</span></a><span class="mw-editsection-bracket">]</span></span></div>
<span class="mw-empty-elt" about="#mwt3" typeof="mw:Transclusion" id="mwNQ" data-mw='{"parts":[{"template":{"target":{"wt":"Çoklu resim","href":"./Şablon:Çoklu_resim"},"params":{"align":{"wt":"right"},"perrow":{"wt":"3"},"total_width":{"wt":"330"},"caption_align":{"wt":"center"},"title":{"wt":""},"image1":{"wt":"Nebahat Çehre.jpg"},"caption1":{"wt":""},"image2":{"wt":"Selma Ergeç.jpg"},"caption2":{"wt":""},"image3":{"wt":"Nur Fettahoğlu.jpg"},"caption3":{"wt":""},"image4":{"wt":""},"caption4":{"wt":""},"image5":{"wt":""},"image6":{"wt":""},"caption6":{"wt":""},"caption":{"wt":""},"caption5":{"wt":""},"footer":{"wt":"{{ortala|Haremin en yetkili kişisi Ayşe Hafsa Sultan&apos;ı oynayan [[Nebahat Çehre]] (solda), onun kızı Hatice Sultan&apos;ı oynayan [[Selma Ergeç]] (ortada) ve Süleyman&apos;ın hasekisi Mahidevran Sultan&apos;ı oynayan [[Nur Fettahoğlu]] (sağda).}}"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r37200200/mw-parser-output/.tmulti" typeof="mw:Extension/templatestyles" about="#mwt4" data-mw='{"name":"templatestyles","attrs":{"src":"Çoklu resim/biçim.css","wrapper":".tmulti"},"body":{"extsrc":""}}'>.mw-parser-output .tmulti .multiimageinner{display:flex;flex-direction:column}.mw-parser-output .tmulti .trow{display:flex;flex-direction:row;clear:left;flex-wrap:wrap;width:100%;box-sizing:border-box}.mw-parser-output .tmulti .tsingle{margin:1px;float:left}.mw-parser-output .tmulti .theader{clear:both;font-weight:bold;text-align:center;align-self:center;background-color:transparent;width:100%}.mw-parser-output .tmulti .thumbcaption{background-color:transparent}.mw-parser-output .tmulti .text-align-left{text-align:left}.mw-parser-output .tmulti .text-align-right{text-align:right}.mw-parser-output .tmulti .text-align-center{text-align:center}@media all and (max-width:720px){.mw-parser-output .tmulti .thumbinner{width:100%!important;box-sizing:border-box;max-width:none!important;align-items:center}.mw-parser-output .tmulti .trow{justify-content:center}.mw-parser-output .tmulti .tsingle{float:none!important;max-width:100%!important;box-sizing:border-box;text-align:center}.mw-parser-output .tmulti .tsingle .thumbcaption{text-align:left}.mw-parser-output .tmulti .trow>.thumbcaption{text-align:center}}@media screen{.mw-parser-output .tmulti .multiimageinner .thumbimage{background-color:inherit}html.skin-theme-clientpref-night .mw-parser-output .tmulti .multiimageinner .thumbimage:not([style*="background-color"]) span:not(.skin-invert-image):not(.skin-invert):not(.bg-transparent) img,html.skin-theme-clientpref-day .mw-parser-output .tmulti .multiimageinner .thumbimage:not([style*="background-color"]) span:not(.bg-transparent) img{background-color:white}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .tmulti .multiimageinner .thumbimage:not([style*="background-color"]) span:not(.skin-invert-image):not(.skin-invert):not(.bg-transparent) img{background-color:white}}</style></span><div class="thumb tmulti tright" about="#mwt3"><div class="thumbinner multiimageinner" style="width:322px;max-width:322px"><div class="trow"><div class="tsingle" style="width:85px;max-width:85px"><div class="thumbimage" style="height:158px;overflow:hidden"><span typeof="mw:File"><a href="https://tr.wikipedia.org/wiki/Dosya:Nebahat_Çehre.jpg" class="mw-file-description"><img resource="https://tr.wikipedia.org/wiki/Dosya:Nebahat_Çehre.jpg" src="//upload.wikimedia.org/wikipedia/commons/7/71/Nebahat_%C3%87ehre.jpg?utm_source=tr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled" decoding="async" loading="lazy" data-file-width="116" data-file-height="221" data-file-type="bitmap" height="158" width="83" class="mw-file-element"/></a></span></div></div><div class="tsingle" style="width:116px;max-width:116px"><div class="thumbimage" style="height:158px;overflow:hidden"><span typeof="mw:File"><a href="https://tr.wikipedia.org/wiki/Dosya:Selma_Ergeç.jpg" class="mw-file-description"><img resource="https://tr.wikipedia.org/wiki/Dosya:Selma_Ergeç.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Selma_Erge%C3%A7.jpg/120px-Selma_Erge%C3%A7.jpg?utm_source=tr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/9/90/Selma_Erge%C3%A7.jpg/250px-Selma_Erge%C3%A7.jpg?utm_source=tr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="542" data-file-height="754" data-file-type="bitmap" height="159" width="114" class="mw-file-element"/></a></span></div></div><div class="tsingle" style="width:115px;max-width:115px"><div class="thumbimage" style="height:158px;overflow:hidden"><span typeof="mw:File"><a href="https://tr.wikipedia.org/wiki/Dosya:Nur_Fettahoğlu.jpg" class="mw-file-description"><img resource="https://tr.wikipedia.org/wiki/Dosya:Nur_Fettahoğlu.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/6/6f/Nur_Fettaho%C4%9Flu.jpg/120px-Nur_Fettaho%C4%9Flu.jpg?utm_source=tr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/6/6f/Nur_Fettaho%C4%9Flu.jpg/250px-Nur_Fettaho%C4%9Flu.jpg?utm_source=tr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="576" data-file-height="802" data-file-type="bitmap" height="157" width="113" class="mw-file-element"/></a></span></div></div></div><div class="trow" style="display:flow-root"><div class="thumbcaption" style="text-align:left"><div class="center" style="width:auto; margin-left:auto; margin-right:auto; ">Haremin en yetkili kişisi Ayşe Hafsa Sultan'ı oynayan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Nebahat_Çehre" title="Nebahat Çehre">Nebahat Çehre</a> (solda), onun kızı Hatice Sultan'ı oynayan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Selma_Ergeç" title="Selma Ergeç">Selma Ergeç</a> (ortada) ve Süleyman'ın hasekisi Mahidevran Sultan'ı oynayan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Nur_Fettahoğlu" title="Nur Fettahoğlu">Nur Fettahoğlu</a> (sağda).</div></div></div></div></div><span class="mw-empty-elt" about="#mwt3"><link rel="mw:PageProp/Category" href="./Kategori:Otomatik_boyutlandırılan_çoklu_resim_kullanılan_sayfalar"/></span>
<p id="mwNg"><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Halit_Ergenç" title="Halit Ergenç" id="mwNw">Halit Ergenç</a>, 10. Osmanlı padişahı <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/I._Süleyman" title="I. Süleyman" id="mwOA">I. Süleyman</a>'ı canlandırdı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Nebahat_Çehre" title="Nebahat Çehre" id="mwOQ">Nebahat Çehre</a>, Süleyman'ın annesi <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Ayşe_Hafsa_Sultan" title="Ayşe Hafsa Sultan" id="mwOg">Ayşe Hafsa Sultan</a>'ı canlandırdı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Meryem_Uzerli" title="Meryem Uzerli" id="mwOw">Meryem Uzerli</a>, başlangıçta Alexandra adıyla tanınan Rutenyalı cariye <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Hürrem_Sultan" title="Hürrem Sultan" id="mwPA">Hürrem Sultan</a>'ı canlandırdı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Okan_Yalabık" title="Okan Yalabık" id="mwPQ">Okan Yalabık</a>, Süleyman'ın can dostu ve daha sonra sadrazam olan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Pargalı_İbrahim_Paşa" title="Pargalı İbrahim Paşa" id="mwPg">Pargalı İbrahim Paşa</a>'yı oynadı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Selma_Ergeç" title="Selma Ergeç" id="mwPw">Selma Ergeç</a>, Süleyman'ın kız kardeşi ve Ayşe Hafta Sultan'ın kızı <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Hatice_Sultan_(I._Selim'in_kızı)" title="Hatice Sultan (I. Selim'in kızı)" id="mwQA">Hatice Sultan</a>'ı canlandırdı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Nur_Fettahoğlu" title="Nur Fettahoğlu" id="mwQQ">Nur Fettahoğlu</a>, Süleyman'a bir erkek evlat (şehzade) vermiş olan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Mahidevran_Sultan" title="Mahidevran Sultan" id="mwQg">Mahidevran Sultan</a>'ı oynadı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Selen_Öztürk" title="Selen Öztürk" id="mwQw">Selen Öztürk</a>, Sultan Süleyman'dan hamile kalmış fakat bebeği öldükten sonra Hatice Sultan'ın nedimesi olmuş olan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Gülfem_Hatun" title="Gülfem Hatun" id="mwRA">Gülfem Hatun</a>'u canlandırdı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Filiz_Ahmet" title="Filiz Ahmet" id="mwRQ">Filiz Ahmet</a>, haremin başkalfası olan Nigar Kalfa'yı oynadı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Sema_Keçik" title="Sema Keçik" id="mwRg">Sema Keçik</a>, Ayşe Hafsa Sultan'ın nedimesi Daye Hatun'u canlandırdı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Selim_Bayraktar" title="Selim Bayraktar" id="mwRw">Selim Bayraktar</a>, haremin başağası olan Sümbül Ağa'yı canlandırdı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Nihan_Büyükağaç" title="Nihan Büyükağaç" id="mwSA">Nihan Büyükağaç</a>, Mahidevran Sultan'ın nedimesi Gülşah Hatun'u oynadı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Burcu_Tuna?action=edit&amp;redlink=1" title="Burcu Tuna (sayfa mevcut değil)" class="new" typeof="mw:LocalizedAttrs" id="mwSQ" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Burcu Tuna"]}}'>Burcu Tuna</a>, Hürrem'in yakın arkadaşı olan ve başlangıçta Maria adını taşıyan Gülnihal Hatun'u oynadı. Mahidevran'ın oğlu <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Şehzade_Mustafa" title="Şehzade Mustafa" id="mwSg">Şehzade Mustafa</a>'nın küçüklüğünü Yusuf Berkan Demirbağ, biraz daha büyümüş hâlini ise Tunç Oral canlandırdı.</p>

<p id="mwSw">Dizinin ilk sezonuna düzenli olarak katılan birçok oyuncu daha oldu. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Alp_Öyken" title="Alp Öyken" id="mwTA">Alp Öyken</a>'in canlandırdığı karakter <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/VII._Clemens" title="VII. Clemens" id="mwTQ">Papa VII. Clemens</a>, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Arif_Erkin_Güzelbeyoğlu" title="Arif Erkin Güzelbeyoğlu" id="mwTg">Arif Erkin</a>'in canlandırdığı karakter <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Pîrî_Mehmed_Paşa" title="Pîrî Mehmed Paşa" id="mwTw">Pîrî Mehmed Paşa</a>, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Fatih_Al" title="Fatih Al" id="mwUA">Fatih Al</a> tarafından canlandırılan karakter <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Matrakçı_Nasuh" title="Matrakçı Nasuh" id="mwUQ">Matrakçı Nasuh</a>, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Oktay_Daner?action=edit&amp;redlink=1" title="Oktay Daner (sayfa mevcut değil)" class="new" typeof="mw:LocalizedAttrs" id="mwUg" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Oktay Daner"]}}'>Oktay Daner</a> tarafından canlandırılan karakter <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Zenbilli_Ali_Efendi" title="Zenbilli Ali Efendi" id="mwUw">Zenbilli Ali Efendi</a>, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Saadet_Işıl_Aksoy" title="Saadet Işıl Aksoy" id="mwVA">Saadet Işıl Aksoy</a>'un canlandırdığı karakter Victoria (Sadıka Hatun), <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Seçkin_Özdemir" title="Seçkin Özdemir" id="mwVQ">Seçkin Özdemir</a>'in oynadığı karakter Leo, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Kevork_Türker" title="Kevork Türker" id="mwVg">Kevork Türker</a>'in canlandırdığı karakter Manolis ve <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Merve_Oflaz" title="Merve Oflaz" id="mwVw">Merve Oflaz</a>'ın oynadığı karakter Ayşe Hatun; dizinin ilk sezonunda düzenli bir şekilde rol aldılar. Bunlara ek olarak <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Yüksel_Ünal?action=edit&amp;redlink=1" title="Yüksel Ünal (sayfa mevcut değil)" class="new" typeof="mw:LocalizedAttrs" id="mwWA" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Yüksel Ünal"]}}'>Yüksel Ünal</a>, sarayın mutfağından sorumlu Şeker Ağa rolünü oynadı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Naci_Adıgüzel?action=edit&amp;redlink=1" title="Naci Adıgüzel (sayfa mevcut değil)" class="new" typeof="mw:LocalizedAttrs" id="mwWQ" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Naci Adıgüzel"]}}'>Naci Adıgüzel</a>, İstanbul'un Venedik elçisini canlandırdı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Kadir_Çermik" title="Kadir Çermik" id="mwWg">Kadir Çermik</a>, Süleyman'ın başlıca rakibi olan Macaristan kralı <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/II._Lajos" title="II. Lajos" id="mwWw">II. Lajos</a>'u canlandırdı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Murat_Tüzün?action=edit&amp;redlink=1" title="Murat Tüzün (sayfa mevcut değil)" class="new" typeof="mw:LocalizedAttrs" id="mwXA" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Murat Tüzün"]}}'>Murat Tüzün</a>, Süleyman'ın veziri ve daha sonra ona ihanet eden <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Hain_Ahmed_Paşa" title="Hain Ahmed Paşa" id="mwXQ">Ahmed Paşa</a> rolünü; <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Kıvanç_Kılınç?action=edit&amp;redlink=1" title="Kıvanç Kılınç (sayfa mevcut değil)" class="new" typeof="mw:LocalizedAttrs" id="mwXg" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Kıvanç Kılınç"]}}'>Kıvanç Kılınç</a> ise hanedan damadı olan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Ferhad_Paşa" title="Ferhad Paşa" class="mw-redirect" id="mwXw">Ferhad Paşa</a> rolünü oynadı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Pınar_Çağlar_Gençtürk" title="Pınar Çağlar Gençtürk" id="mwYA">Pınar Çağlar Gençtürk</a>, Ferhad Paşa'nın eşi ve Süleyman'ın kız kardeşi olan <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Beyhan_Sultan_(I._Selim'in_kızı)" title="Beyhan Sultan (I. Selim'in kızı)" id="mwYQ">Beyhan Sultan</a>'ı oynadı. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Fehmi_Karaarslan?action=edit&amp;redlink=1" title="Fehmi Karaarslan (sayfa mevcut değil)" class="new" typeof="mw:LocalizedAttrs" id="mwYg" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Fehmi Karaarslan"]}}'>Fehmi Karaarslan</a>, divanın vezirlerinden <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Ayas_Mehmed_Paşa" title="Ayas Mehmed Paşa" id="mwYw">Ayas Mehmed Paşa</a>'yı canlandırdı.</p>

<p id="mwZA"><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/İlker_Aksum" title="İlker Aksum" id="mwZQ">İlker Aksum</a> idam edilen kaptan-ı deryâ <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Câfer_Ağa" title="Câfer Ağa" id="mwZg">Câfer Ağa</a> rolüyle, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Ali_Uyandıran" title="Ali Uyandıran" id="mwZw">Ali Uyandıran</a> Süleyman'ın babası I. Selim'in dostu <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Hasan_Can_Çelebi" title="Hasan Can Çelebi" id="mwaA">Hasan Can</a> rolüyle, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Engin_Günaydın" title="Engin Günaydın" id="mwaQ">Engin Günaydın</a> haremin ağalarından Gül Ağa rolüyle, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Nusret_Çetinel" title="Nusret Çetinel" id="mwag">Nusret Çetinel</a> padişahın lalası Kâsım Paşa rolüyle, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Binnur_Kaya" title="Binnur Kaya" id="mwaw">Binnur Kaya</a> muska yazıp büyücülük yapan Muskacı Hatun rolüyle, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Cem_Bender" title="Cem Bender" id="mwbA">Cem Bender</a> yeniçeri ağası Mustafa Ağa rolüyle, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Tansu_Biçer" title="Tansu Biçer" id="mwbQ">Tansu Biçer</a> sarayın nakkaşhanesinden sorumlu Ahmed Çelebi rolüyle, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Tansel_Öngel" title="Tansel Öngel" id="mwbg">Tansel Öngel</a> Venedik liderinin (<a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Doçe" title="Doçe" id="mwbw">doçe</a>) oğlu <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Alvise_Gritti" title="Alvise Gritti" id="mwcA">Alvise Gritti</a> rolüyle, <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Bergüzar_Korel" title="Bergüzar Korel" id="mwcQ">Bergüzar Korel</a> ise Monica Teresse rolüyle dizide konuk oyuncu olarak yer aldı. Engin Günaydın ve Tansel Öngel, dizinin ikinci sezonunda düzenli bir şekilde rol almaya başladılar.</p>

</section><section data-mw-section-id="4" id="mwcg" aria-labelledby="Yayın_bilgileri"><div class="mw-heading mw-heading2"><h2 id="Yayın_bilgileri"><span id="Yay.C4.B1n_bilgileri" typeof="mw:FallbackId"></span>Yayın bilgileri</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;veaction=edit&amp;section=4" title="Değiştirilen bölüm: Yayın bilgileri" class="mw-editsection-visualeditor"><span>değiştir</span></a><span class="mw-editsection-divider"> | </span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;action=edit&amp;section=4" title="Bölümün kaynak kodunu değiştir: Yayın bilgileri"><span>kaynağı değiştir</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwcw">İlk bölüm, 10,87 reyting ve 24,84 share alarak <i id="mwdA"><a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Çocuklar_Duymasın" title="Çocuklar Duymasın" id="mwdQ">Çocuklar Duymasın</a></i><span typeof="mw:Nowiki" id="mwdg"></span>'ın ardından ikinci oldu. İkinci bölümden itibaren her bölümde izlenme oranını daha da arttırarak zirveye oturdu ve sonrasında zirveden inmedi. Dizinin her yeni bölümü Türkiye'de çarşamba akşamları <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Show_TV" title="Show TV" id="mwdw">Show TV</a> kanalında gösterildi. Sezonun en çok izlenen bölümü, 17,63 reyting alan 12. bölüm oldu.</p>

</section><section data-mw-section-id="5" id="mweA" aria-labelledby="Ödüller_ve_adaylıklar"><div class="mw-heading mw-heading2"><h2 id="Ödüller_ve_adaylıklar"><span id=".C3.96d.C3.BCller_ve_adayl.C4.B1klar" typeof="mw:FallbackId"></span>Ödüller ve adaylıklar</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;veaction=edit&amp;section=5" title="Değiştirilen bölüm: Ödüller ve adaylıklar" class="mw-editsection-visualeditor"><span>değiştir</span></a><span class="mw-editsection-divider"> | </span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;action=edit&amp;section=5" title="Bölümün kaynak kodunu değiştir: Ödüller ve adaylıklar"><span>kaynağı değiştir</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mweQ">Dizi, ilk sezonuyla <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/2011_Antalya_Televizyon_Ödülleri" title="2011 Antalya Televizyon Ödülleri" id="mweg">2011 Antalya Televizyon Ödülleri</a>'ne 10 dalda aday gösterildi ve "En İyi Drama Dizisi", "En İyi Dönem Dizisi", "En İyi Dizi Erkek Oyuncu" ve "En İyi Dizi/Film Sanat Yönetmeni" olmak üzere 4 dalda ödülün sahibi oldu. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Okan_Yalabık" title="Okan Yalabık" id="mwew">Okan Yalabık</a>, Pargalı İbrahim Paşa rolüyle "En İyi Dizi Erkek Oyuncu" seçildi. Hürrem Sultan rolünü canlandıran <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Meryem_Uzerli" title="Meryem Uzerli" id="mwfA">Meryem Uzerli</a>, "En İyi Dizi Kadın Oyuncu" dalında aday gösterildi. <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Filiz_Ahmet" title="Filiz Ahmet" id="mwfQ">Filiz Ahmet</a> ise Nigar Kalfa karakteriyle "En İyi Dizi Yardımcı Kadın Oyuncu" için aday gösterildi. Dizinin hem yönetmeni <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Taylan_Biraderler" title="Taylan Biraderler" id="mwfg">Taylan Biraderler</a> hem de senaristi <a rel="mw:WikiLink" href="https://tr.wikipedia.org/wiki/Meral_Okay" title="Meral Okay" id="mwfw">Meral Okay</a>, kendi dallarında verilen ödüllere aday gösterildiler.</p>

</section><section data-mw-section-id="6" id="mwgA" aria-labelledby="Bölümler_listesi"><div class="mw-heading mw-heading2"><h2 id="Bölümler_listesi"><span id="B.C3.B6l.C3.BCmler_listesi" typeof="mw:FallbackId"></span>Bölümler listesi</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;veaction=edit&amp;section=6" title="Değiştirilen bölüm: Bölümler listesi" class="mw-editsection-visualeditor"><span>değiştir</span></a><span class="mw-editsection-divider"> | </span><a href="/w/index.php?title=Muhte%C5%9Fem_Y%C3%BCzy%C4%B1l_(1._sezon)&amp;action=edit&amp;section=6" title="Bölümün kaynak kodunu değiştir: Bölümler listesi"><span>kaynağı değiştir</span></a><span class="mw-editsection-bracket">]</span></span></div>
