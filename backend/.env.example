# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL — Supabase veya Neon önerilir)
DATABASE_URL=postgresql://user:password@localhost:5432/friendgames

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# RevenueCat (webhook doğrulaması için)
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# Optional: VIP Tabu AI deck generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
