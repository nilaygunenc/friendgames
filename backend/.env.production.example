# ─────────────────────────────────────────────────────────────────
# FriendGames Backend - PRODUCTION Environment Variables
# ─────────────────────────────────────────────────────────────────
# Bu dosyayı .env olarak kopyala ve değerleri doldur
# ─────────────────────────────────────────────────────────────────

# Server Configuration
PORT=3000
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────
# Database (ZORUNLU)
# ─────────────────────────────────────────────────────────────────
# Supabase: https://supabase.com → Project Settings → Database → URI
# Neon: https://neon.tech → Dashboard → Connection string
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────────────────────────
# JWT Authentication (ZORUNLU - DEĞİŞTİR!)
# ─────────────────────────────────────────────────────────────────
# Random key oluşturmak için:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=BURAYA_GÜÇLÜ_BİR_RANDOM_KEY_EKLE_64_KARAKTER
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────
# Admin Users (ZORUNLU)
# ─────────────────────────────────────────────────────────────────
# Gerçek admin email adreslerini ekle
ADMIN_EMAILS=admin@yourcompany.com,developer@yourcompany.com

# ─────────────────────────────────────────────────────────────────
# RevenueCat (VIP için gerekli)
# ─────────────────────────────────────────────────────────────────
# https://app.revenuecat.com → Settings → Integrations → Webhooks
REVENUECAT_WEBHOOK_SECRET=rc_webhook_secret_from_revenuecat_dashboard

# ─────────────────────────────────────────────────────────────────
# Deployment Platformları için Örnekler
# ─────────────────────────────────────────────────────────────────

# Render.com:
# 1. Dashboard → Environment Variables
# 2. Yukarıdaki tüm değerleri ekle
# 3. DATABASE_URL Supabase'den al
# 4. JWT_SECRET random oluştur
# 5. Deploy!

# Railway.app:
# railway variables set DATABASE_URL="postgresql://..."
# railway variables set JWT_SECRET="..."
# railway variables set NODE_ENV="production"

# Fly.io:
# fly secrets set DATABASE_URL="postgresql://..."
# fly secrets set JWT_SECRET="..."
# fly secrets set NODE_ENV="production"

# ─────────────────────────────────────────────────────────────────
# Güvenlik Kontrol Listesi
# ─────────────────────────────────────────────────────────────────
# [ ] DATABASE_URL gerçek database'e bağlı
# [ ] JWT_SECRET değiştirildi (64+ karakter random)
# [ ] NODE_ENV=production
# [ ] ADMIN_EMAILS gerçek email'ler
# [ ] HTTPS kullanılıyor
# [ ] CORS production domain'e kısıtlı
# [ ] Rate limiting aktif
# [ ] Database backup aktif
# ─────────────────────────────────────────────────────────────────
